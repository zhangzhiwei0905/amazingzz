{
    "name": "amazingzz",
    "version": "0.2.3",
    "description": "Configure Codex CLI, OpenClaw, Hermes, and Claude Code for the AmazingZZ sub2api gateway.",
    "type": "module",
    "bin": {
        "amazingzz": "dist/index.js"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "dev": "tsx src/index.ts",
        "test": "vitest run",
        "check": "tsc -p tsconfig.json --noEmit",
        "prepublishOnly": "npm run check && npm test && npm run build"
    },
    "dependencies": {
        "@inquirer/prompts": "^7.2.1",
        "commander": "^12.1.0",
        "yaml": "^2.6.1"
    },
    "devDependencies": {
        "@types/node": "^22.10.2",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2",
        "vitest": "^2.1.8"
    },
    "keywords": [
        "codex",
        "openclaw",
        "hermes",
        "openai",
        "sub2api"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zhangzhiwei0905/amazingzz.git"
    },
    "bugs": {
        "url": "https://github.com/zhangzhiwei0905/amazingzz/issues"
    },
    "homepage": "https://github.com/zhangzhiwei0905/amazingzz#readme"
}
